# Server-only backend origin. Set a reachable HTTPS service URL in deployed environments.
FORMA_API_URL=http://127.0.0.1:4100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Server-only Google OAuth web client credentials. Never add NEXT_PUBLIC_ to the secret.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Facebook Login for Web. App ID is only read by the server route; never add NEXT_PUBLIC_ to these values.
# FACEBOOK_APP_ID=...
# FACEBOOK_GRAPH_VERSION=vXX.X
# FACEBOOK_REDIRECT_URI=http://localhost:3000/api/customer/facebook/callback
