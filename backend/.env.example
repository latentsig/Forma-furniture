DATABASE_URL=postgres://forma_dev:replace-me@127.0.0.1:5432/forma_furniture
PORT=4100
FRONTEND_ORIGIN=http://localhost:3000
CUSTOMER_APP_ORIGIN=http://localhost:3000
# Phase 5 COD remains closed by default. Merchant must approve delivery PINs,
# fees and COD policy before setting these server-only values.
DELIVERY_SERVICEABLE_PIN_CODES=
DELIVERY_FEE_PAISE=0
COD_ENABLED=false
# Customer email verification and password reset through Resend; never NEXT_PUBLIC_*.
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM=Forma Furniture <accounts@your-verified-domain.example>
# Local-only convenience: show one-use email links in API responses while testing.
# AUTH_LOCAL_DEV_LINKS=true
# Deliberate local-only first-owner setup switch. Never set in production.
# ADMIN_LOCAL_SETUP_ENABLED=true
# Same Google OAuth web client ID as the frontend callback configuration.
# GOOGLE_CLIENT_ID=...
# Facebook Login for Web. Keep the app secret server-side and use the same exact callback URI in both env files.
# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...
# FACEBOOK_GRAPH_VERSION=vXX.X
# FACEBOOK_REDIRECT_URI=http://localhost:3000/api/customer/facebook/callback
# 32-byte hex key; encrypts MFA secrets stored in PostgreSQL. Keep in a secret manager.
# ADMIN_MFA_ENCRYPTION_KEY=GENERATE_A_RANDOM_32_BYTE_HEX_KEY
# Configure only for the one-time CLI bootstrap; never expose in NEXT_PUBLIC_*.
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=Use-a-generated-15-character-minimum-secret
# OWNER_TOTP_SECRET=BASE32SECRETGENERATEDOUTSIDEGIT
# OWNER_TOTP_CODE=CURRENT_6_DIGIT_AUTHENTICATOR_CODE
