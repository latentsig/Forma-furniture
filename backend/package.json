{
  "name": "forma-furniture-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-strip-types src/db/seed.ts",
    "admin:bootstrap-owner": "node --env-file-if-exists=.env.local --experimental-strip-types src/auth/bootstrap-owner.ts",
    "test:runtime-config": "node --experimental-strip-types src/runtime-config.test.ts",
    "test:payments": "node --experimental-strip-types src/payments/domain.test.ts",
    "test:fulfillment": "node --experimental-strip-types src/fulfillment/domain.test.ts",
    "test:ai-imagery": "node --experimental-strip-types src/ai-imagery/domain.test.ts",
    "test:integration": "npm run db:migrate && npm run db:seed && node --experimental-test-isolation=none --test-concurrency=1 --env-file-if-exists=.env.local --experimental-strip-types --test src/integration.test.ts src/auth/security.test.ts src/auth/facebook-auth.test.ts src/commerce/service.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22.18" }
}
