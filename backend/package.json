{
  "name": "forma-furniture-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-strip-types src/db/seed.ts",
    "test:integration": "npm run db:migrate && npm run db:seed && node --env-file-if-exists=.env.local --experimental-strip-types --test src/integration.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22.18" }
}
